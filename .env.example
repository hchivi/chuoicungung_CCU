# MongoDB Atlas Connection URI
MONGODB_URI=your_mongodb_connection_string_here
PORT=5050

# SUPPI + CHAINY share one backend and conversation. Gemini direct is recommended.
# This model has a free tier, subject to Google project quota and billing settings.
# Server-only: never use a VITE_ prefix for credentials.
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional existing Dify app. Explicitly set ASSISTANT_PROVIDER=dify to use it.
# The published Dify app chooses the model; CCU cannot verify it from a label.
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
# Set a random secret in the deployment secret store; never commit real values.
ASSISTANT_SESSION_SECRET=

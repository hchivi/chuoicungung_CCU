# Database Options (MongoDB or Supabase PostgreSQL)
MONGODB_URI=your_mongodb_connection_string_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
PORT=5050

# SUPPI + CHAINY share one backend and conversation. Gemini direct is recommended.
# This model has a free tier, subject to Google project quota and billing settings.
# Server-only: never use a VITE_ prefix for credentials.
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Two-model routing. 'single' rolls back to the simple model only.
# Free-tier availability depends on your Google project; billing is not changed.
GEMINI_ROUTING=auto
GEMINI_SIMPLE_MODEL=gemini-3.1-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.5-flash
# Optional existing Dify app. Explicitly set ASSISTANT_PROVIDER=dify to use it.
# The published Dify app chooses the model; CCU cannot verify it from a label.
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=
# Set a random secret in the deployment secret store; never commit real values.
ASSISTANT_SESSION_SECRET=

# Customer social login. Server-only; provider secrets are configured in Supabase.
SITE_URL=http://localhost:3000
# Optional dedicated signing secret; otherwise the server Supabase key signs OAuth state.
SESSION_SECRET=
# Only after a compatible Zalo custom OAuth provider has been configured and tested.
# Example provider identifier: custom:zalo (not an App ID or an API key).
ZALO_SUPABASE_PROVIDER=
